{
    "name": "datatables.net-searchpanes-bm",
    "description": "SearchPanes for DataTables with styling for [Bulma](https://bulma.io/)",
    "main": "./js/searchPanes.bulma.js",
    "module": "./js/searchPanes.bulma.mjs",
    "style": "./css/searchPanes.bulma.css",
    "types": "./types/searchPanes.bulma.d.ts",
    "version": "2.3.5",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "SearchPanes",
        "search",
        "filtering",
        "Bulma",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-searchpanes": "3.0.0-beta.1",
        "datatables.net-bm": "^3"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "SEE LICENSE IN License.txt",
    "exports": {
        ".": {
            "types": "./types/searchPanes.bulma.d.ts",
            "style": "./css/searchPanes.bulma.css",
            "import": "./js/searchPanes.bulma.mjs",
            "require": "./js/searchPanes.bulma.js",
            "default": "./js/searchPanes.bulma.mjs"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/searchPanes.bulma.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/SearchPanes.git"
    }
}